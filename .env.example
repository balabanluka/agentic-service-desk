OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_CORPUS_VERSION=kb-v1
KNOWLEDGE_DEFAULT_TOP_K=4

# Local pgvector database. Use a real local password in .env; never commit .env.
POSTGRES_DB=agentic_service_desk
POSTGRES_USER=agentic
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql://agentic:change-me@127.0.0.1:5432/agentic_service_desk
